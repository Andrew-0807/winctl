{
  "productName": "WinCTL",
  "version": "2.0.2",
  "identifier": "com.winctl.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8787",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:* http://localhost:* https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com"
    },
    "windows": [
      {
        "title": "WinCTL",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Andrew-0807/winctl/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxRUM2QUQ3QzcxQTU4NkEKUldScVdCckgxMnJzWVNtd3FHMEh4UmpRRG1xUnpQZTR1a3RYUnhPTkk5bU9GeFhzcERrd055ejIK"
    }
  }
}